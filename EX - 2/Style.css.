
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #f5f4ff;
  color: #25234a;
  line-height: 1.6;
}

header {
  background: #5b4fe0;
  color: white;
  padding: 18px 6%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
}

header h1 {
  font-size: 28px;
}

nav {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

nav a {
  color: white;
  text-decoration: none;
  font-weight: bold;
}

nav a:hover {
  color: #dcd8ff;
}

section {
  padding: 45px 8%;
}

.hero {
  text-align: center;
  background: linear-gradient(135deg, #eeecff, #ffffff);
  padding-top: 60px;
  padding-bottom: 60px;
}

.hero h2 {
  font-size: 36px;
  color: #5145cd;
  margin-bottom: 10px;
}

.hero p {
  margin-bottom: 25px;
}

form {
  background: white;
  max-width: 650px;
  margin: 25px auto;
  padding: 25px;
  border-radius: 16px;
  box-shadow: 0 5px 20px #30208015;
  display: flex;
  flex-direction: column;
  gap: 12px;
  text-align: left;
}

input,
select {
  width: 100%;
  padding: 12px;
  border: 1px solid #d8d5f0;
  border-radius: 8px;
  font-size: 15px;
  background: white;
}

input:focus,
select:focus {
  outline: 2px solid #a7a0ff;
}

button {
  background: #5b4fe0;
  color: white;
  border: none;
  padding: 12px 20px;
  border-radius: 9px;
  cursor: pointer;
  font-size: 15px;
  font-weight: bold;
  transition: 0.2s;
}

button:hover {
  background: #4035bd;
  transform: translateY(-1px);
}

h2 {
  margin-bottom: 20px;
  color: #5145cd;
}

.bus-card {
  background: white;
  padding: 25px;
  margin: 18px 0;
  border-radius: 14px;
  box-shadow: 0 4px 18px #30208012;
  border: 1px solid #e7e4ff;
}

.bus-card h3 {
  color: #5145cd;
  margin-bottom: 10px;
}

.bus-card p {
  margin: 6px 0;
}

.deck-buttons {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin: 20px 0;
}

.seat-layout {
  display: grid;
  grid-template-columns: repeat(5, minmax(45px, 65px));
  gap: 12px;
  margin: 25px 0;
  max-width: 400px;
}

.seat {
  min-height: 45px;
  padding: 8px 4px;
  border-radius: 8px;
  background: #c8f7d2;
  color: #17652c;
  border: 1px solid #8bd99b;
  font-size: 13px;
}

.seat.booked {
  background: #ffd6d6;
  color: #a21d1d;
  border-color: #f2a0a0;
  cursor: not-allowed;
}

.seat.selected {
  background: #dcd7ff;
  color: #4035bd;
  border: 2px solid #5b4fe0;
}

#seatSummary,
#totalFare {
  font-weight: bold;
  margin: 12px 0;
}

#passenger form {
  margin-left: 0;
}

#bookingResult {
  background: white;
  padding: 25px;
  border-radius: 14px;
  border-left: 5px solid #5b4fe0;
  box-shadow: 0 4px 18px #30208012;
  overflow-wrap: anywhere;
}

footer {
  background: #25234a;
  color: white;
  text-align: center;
  padding: 20px;
  margin-top: 25px;
}

@media (max-width: 650px) {
  header {
    flex-direction: column;
    align-items: flex-start;
  }

  nav {
    gap: 12px;
  }

  .hero h2 {
    font-size: 28px;
  }

  section {
    padding: 30px 5%;
  }

  form {
    padding: 18px;
  }

  .seat-layout {
    grid-template-columns: repeat(4, minmax(45px, 60px));
    gap: 8px;
  }
}
