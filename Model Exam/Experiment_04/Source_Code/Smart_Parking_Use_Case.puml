@startuml
left to right direction
skinparam packageStyle rectangle
actor Driver
actor "Parking Attendant" as Attendant
actor Administrator as Admin
actor "Payment Gateway" as Payment
rectangle "Smart Parking Management System" {
 usecase "Search Available Slots" as UC1
 usecase "Reserve Slot in Advance" as UC2
 usecase "Pay Parking Fee Online" as UC3
 usecase "Enter Parking" as UC4
 usecase "Read Vehicle Number Plate" as UC5
 usecase "Open Barrier" as UC6
 usecase "Handle Lost Ticket" as UC7
 usecase "Configure Tariff" as UC8
 usecase "View Occupancy Reports" as UC9
}
Driver --> UC1
Driver --> UC2
Driver --> UC3
Driver --> UC4
UC4 .> UC5 : <<include>>
UC4 .> UC6 : <<include>>
UC3 --> Payment
Attendant --> UC7
Admin --> UC8
Admin --> UC9
@enduml
